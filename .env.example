# Copy to .env.local for local development, and add the same two values in
# Vercel → Project → Settings → Environment Variables.
# Both are PUBLIC values (they ship in the browser). Access is enforced by the
# database's Row Level Security, not by hiding these.
# NEVER put the service_role / secret key here or anywhere in this project.

# Supabase → Project Settings → API (or Data API) → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...) or the legacy anon key
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
